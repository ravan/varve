+
+// batchWithTwoEdges builds a batch holding one standalone node and two edge
+// statements, so a suffix assertion can prove it lands on EVERY statement of the
+// ';'-separated program rather than only the leading INSERT.
+func batchWithTwoEdges() *txBatch {
+	var b txBatch
+	b.node("Artifact", kv{"_id", "art:sha256:ab"}, kv{"algorithm", "sha256"})
+	b.edge("PkgVersion", "pkg:v:1", "IsOccurrenceSubject", "IsOccurrence", "occ:1")
+	b.edge("IsOccurrence", "occ:1", "IsOccurrenceArtifact", "Artifact", "art:sha256:ab")
+	return &b
+}
+
+// TestBatchProgramValidFromDefaultIsUnchanged pins the back-compatibility
+// guarantee for --varve-valid-from: the zero time must render a program with no
+// VALID FROM clause anywhere, byte-identical to one from before the option
+// existed. gallery/guac depends on this.
+func TestBatchProgramValidFromDefaultIsUnchanged(t *testing.T) {
+	prog := batchWithTwoEdges().program(time.Time{})
+	if strings.Contains(prog, "VALID FROM") {
+		t.Fatalf("zero validFrom must render no VALID FROM clause, got %q", prog)
+	}
+	// Every statement ends where the next begins — no stray suffix or separator.
+	if got, want := strings.Count(prog, ";\n"), 2; got != want {
+		t.Fatalf("expected %d statement separators, got %d in %q", want, got, prog)
+	}
+}
+
+// TestBatchProgramValidFromSuffixesEveryStatement asserts the clause is appended
+// to the leading INSERT *and* to each per-edge MATCH...INSERT, and that the
+// timestamp is normalised to UTC RFC3339 whatever offset was supplied.
+func TestBatchProgramValidFromSuffixesEveryStatement(t *testing.T) {
+	// 10:15:00 at +01:00 is 09:15:00Z — asserts normalisation, not just escaping.
+	validFrom, err := time.Parse(time.RFC3339, "2021-12-10T10:15:00+01:00")
+	if err != nil {
+		t.Fatalf("parsing the fixture timestamp: %v", err)
+	}
+	prog := batchWithTwoEdges().program(validFrom)
+
+	const want = " VALID FROM TIMESTAMP '2021-12-10T09:15:00Z'"
+	stmts := strings.Split(prog, ";\n")
+	if len(stmts) != 3 {
+		t.Fatalf("expected 3 statements (1 INSERT + 2 edges), got %d: %q", len(stmts), prog)
+	}
+	for i, s := range stmts {
+		if !strings.HasSuffix(s, want) {
+			t.Errorf("statement %d does not end with %q:\n%q", i, want, s)
+		}
+	}
+	if got := strings.Count(prog, "VALID FROM"); got != 3 {
+		t.Errorf("expected exactly 3 VALID FROM clauses, got %d in %q", got, prog)
+	}
+	// The clause must follow the INSERT, not sit inside the pattern.
+	if !strings.HasPrefix(stmts[0], "INSERT (:Artifact") {
+		t.Errorf("clause must not disturb the INSERT pattern: %q", stmts[0])
+	}
+}
