+// validFromClause renders the ` VALID FROM TIMESTAMP '…'` suffix that backdates
+// a statement's valid-time, or "" for the zero time — the default, meaning
+// valid-from = commit time and therefore a program byte-identical to one from
+// before this option existed. varve accepts the clause on both `INSERT …` and
+// `MATCH … INSERT …`, which is why program() can append it uniformly to every
+// statement it renders. The timestamp goes through Lit, so it is escaped and
+// normalised to UTC RFC3339Nano whatever offset the operator supplied.
+func validFromClause(validFrom time.Time) string {
+	if validFrom.IsZero() {
+		return ""
+	}
+	return " VALID FROM TIMESTAMP " + Lit(validFrom)
+}
